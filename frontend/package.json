{
  "name": "@senialon/frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "prebuild": "npm run contract:check",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "contract:generate": "node scripts/generate-contract.mjs",
    "contract:check": "node scripts/generate-contract.mjs --check",
    "test": "vitest run",
    "pretest:e2e": "node scripts/build-e2e.mjs",
    "test:e2e": "playwright test",
    "pretest:e2e:runs": "node scripts/build-e2e.mjs",
    "test:e2e:runs": "playwright test --config playwright.runs.config.ts",
    "pretest:e2e:comparison": "node scripts/build-e2e.mjs",
    "test:e2e:comparison": "playwright test --config playwright.comparison.config.ts",
    "pretest:e2e:publications": "node scripts/build-e2e.mjs",
    "test:e2e:publications": "playwright test --config playwright.publications.config.ts",
    "pretest:e2e:analysis": "node scripts/build-e2e.mjs",
    "test:e2e:analysis": "playwright test --config playwright.analysis.config.ts",
    "pretest:e2e:review": "node scripts/build-e2e.mjs",
    "test:e2e:review": "playwright test --config playwright.review.config.ts",
    "security:client": "node scripts/check-client-boundary.mjs",
    "test:types": "node scripts/check-contract-types.mjs",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fontsource-variable/sora": "5.3.0",
    "@fontsource-variable/work-sans": "5.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
